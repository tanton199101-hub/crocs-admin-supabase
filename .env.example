AMAZON_SELLER_ID=replace_me
AMAZON_MARKETPLACE_ID=A1F83G8C2ARO7P
AMAZON_SP_API_ENDPOINT=sellingpartnerapi-eu.amazon.com
AMAZON_AWS_REGION=us-east-1
