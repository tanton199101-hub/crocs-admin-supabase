# The static app uses the publishable key in supabase-config.js.
# Never expose a Supabase secret/service-role key in browser code.
SUPABASE_URL=https://uvtgzcuifbiufwcrylxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only values for Stripe Checkout. Never put these in supabase-config.js,
# browser storage, the static dist folder or GitHub.
SUPABASE_SERVICE_ROLE_KEY=service_role_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STOREFRONT_URL=https://crocs-admin-supabase.vercel.app
# Keep live mode locked until a real payment test, refund test and webhook
# replay test have been completed.
STRIPE_ALLOW_LIVE=false

# Server-only Amazon Selling Partner API values. Never expose these in browser
